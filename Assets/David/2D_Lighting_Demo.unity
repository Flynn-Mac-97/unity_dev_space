--- !u!114 &1257908250
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1257908248}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd4d5e20dbf812f47aa9766e0c64eb1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _requiredItem: {fileID: 11400000, guid: b5a56e57334176447b498384cf4a11d9, type: 2}
  _requiredCount: 3
  _requestLine: "A maintenance unit? Been a while. My gate lever's seized \u2014
    bring me 3 metal scrap and I'll crank it open."
  _thanksLine: "Good scrap, this. There \u2014 gate's open. Top your cells off before
    you cross."
  _askedBarks:
  - Metal scrap. Three pieces. The grey nodes past the rocks.
  - No scrap, no crossing. Lever won't move itself.
  - You hum when you walk. Old models did that too.
  - Wind's been kinder lately. You fixing things has a smell to it.
  - I'd help you look, but my knees rusted before you were compiled.
  - The far side of the island. Grey, glinting. Can't miss it.
  _doneBarks:
  - Gate's open. Go on, before I get sentimental.
  - Safe travels, little fixer.
  - Tell the next island an old man says hello.
  - You'll do fine out there. You listen. Rare, that.
  _fullRecharge: 1
  _barkYOffset: 1.6
  _barkSortingOrder: 10060
  onFirstTalk:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 125608176}
        m_TargetAssemblyTypeName: Flynn.Demo.DemoFlowDirector, Flynn.Runtime
        m_MethodName: OnFirstTalk
        m_Mode: 0
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
