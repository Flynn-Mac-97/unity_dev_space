/* InteractTag — MVP blockout. Flat black, 1px white, square. */

.interact-tag {
    position: absolute;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    display: none;
}
.interact-tag__label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
