/* Pause menu — Flynn wireframe palette: black surfaces, 1px white outlines, square corners. */

.hidden { display: none; }

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.pause-panel {
    width: 360px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    flex-direction: column;
    align-items: center;
    padding: 32px;
}

.pause-title {
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 24px;
}

.resume-button {
    width: 200px;
    height: 44px;
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    transition-duration: 0s;
}

.resume-button:hover {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

.resume-button:active {
    background-color: rgba(255, 255, 255, 0.6);
    color: rgb(0, 0, 0);
}