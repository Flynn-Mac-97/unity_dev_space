/* PlayerHUD — flat black plates, 1px white, square corners.
   Layout: STATUS top-left · SIGNAL top-center · RESOURCES+OBJECTIVES right rail ·
   ACTION BLOCK (buildup bar docked on hotbar) bottom-center. */

.hud-root {
    flex-grow: 1;
}

/* ── Shared plate treatment ─────────────────────────────────────── */

.hud-plate {
    background-color: rgba(0, 0, 0, 0.82);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    padding: 8px 12px;
}

.plate-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.plate-cap {
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    -unity-font-style: bold;
}

.plate-value {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ── Battery (top-left) ─────────────────────────────────────────── */

.battery {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 220px;
    flex-direction: column;
}

.battery-gauge {
    height: 12px;
    background-color: rgb(0, 0, 0);
    border-color: rgba(255, 255, 255, 0.7);
    border-width: 1px;
    padding: 2px;
    flex-direction: row;
}

.battery-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
}

.battery-fill--low {
    background-color: rgb(255, 59, 48);
}

/* ── Signal / transmitter (top-center) ──────────────────────────── */

.transmitter {
    position: absolute;
    top: 20px;
    left: 50%;
    translate: -50% 0;
    width: 300px;
    flex-direction: column;
}

.transmitter-gauge {
    height: 12px;
    background-color: rgb(0, 0, 0);
    border-color: rgba(255, 255, 255, 0.7);
    border-width: 1px;
    padding: 2px;
    flex-direction: row;
    position: relative;
    overflow: hidden;
}

.transmitter-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 255, 255);
}

.transmitter-fill--low {
    background-color: rgb(255, 59, 48);
}

.gauge-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.35);
}
.gauge-tick--25 { left: 25%; }
.gauge-tick--50 { left: 50%; }
.gauge-tick--75 { left: 75%; }

/* ── Echo counter (top-right) ───────────────────────────────────── */

.echo {
    position: absolute;
    top: 20px;
    right: 20px;
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
}

.echo-icon {
    margin-right: 10px;
    color: rgb(255, 255, 255);
    font-size: 18px;
}

.echo-count {
    min-width: 34px;
    -unity-text-align: middle-right;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ── Objective chips — right rail under the echo counter ────────── */

.objective-chips {
    position: absolute;
    top: 70px;
    right: 20px;
    flex-direction: column;
    align-items: flex-end;
    max-width: 320px;
}

.objective-chip {
    background-color: rgba(0, 0, 0, 0.82);
    border-color: rgba(255, 255, 255, 0.5);
    border-width: 1px;
    padding: 6px 12px;
    margin-bottom: 4px;
    flex-direction: row;
    align-items: center;
}

.objective-chip.completed {
    color: rgb(52, 199, 89);
    border-color: rgb(52, 199, 89);
}

.objective-chip-symbol {
    color: rgb(255, 255, 255);
    font-size: 14px;
    margin-right: 8px;
    min-width: 14px;
}

.objective-chip.completed .objective-chip-symbol {
    color: rgb(52, 199, 89);
}

.objective-chip-title {
    color: rgb(255, 255, 255);
    font-size: 14px;
    white-space: normal;
}

.objective-chip.completed .objective-chip-title {
    color: rgb(52, 199, 89);
    -unity-font-style: italic;
}

/* ── Action block: buildup bar docked flush on the hotbar plate ─── */

.hotbar {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.hotbar-plate {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.82);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    padding: 6px;
}

.hotbar-slot {
    width: 58px;
    height: 58px;
    background-image: url("../../../../David/UI/UI-Sprites/item_slot.png");
    border-color: rgba(255, 255, 255, 0.45);
    border-width: 1px;
    margin-left: 3px;
    margin-right: 3px;
    align-items: center;
    justify-content: center;
}

.hotbar-slot--active {
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    background-color: rgba(255, 255, 255, 0.10);
}

.slot-key {
    position: absolute;
    top: 2px;
    left: 5px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: bold;
}

.slot-icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

.slot-count {
    position: absolute;
    bottom: 2px;
    right: 5px;
    font-size: 13px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    display: none;
}

/* Buildup bar: same width as the hotbar plate (4×58 + margins + padding ≈ 276),
   sitting flush on top of it — one action block. Sweetspot = gold. */

.power-buildup {
    position: absolute;
    bottom: 95px;   /* hotbar bottom 24 + plate height ~71 → flush dock */
    left: 50%;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
}

.power-buildup-bar {
    width: 276px;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    padding: 2px;
    flex-direction: row;
    position: relative;
    overflow: hidden;
}

.power-buildup-perfect {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 204, 0, 0.15);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(255, 204, 0, 0.7);
    border-right-color: rgba(255, 204, 0, 0.7);
}

.power-buildup-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 255, 255);
}

.power-buildup-fill--perfect { background-color: rgb(255, 204, 0); }
.power-buildup-fill--flash   { background-color: rgb(255, 255, 255); }

.power-buildup-label {
    margin-top: 3px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
