/* Player HUD — David's UI, progress bar in top-left. */

.hud-root {
    flex-grow: 1;
}

/* ── Progress bar (top-left) ──────────────────────────────────────────────── */

.progress-bar {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 300px;
    height: 30px;
    background-image: url("../UI-Sprites/progress-bar.jpg");
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.3);
}

.progress-label {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
}