/* Flynn wireframe palette — black surfaces, 1px white outlines, square corners. */

.hidden { display: none; }

.dialogue-panel {
    position: absolute;
    width: 940px;
    left: 50%;
    translate: -470px 0;
    bottom: 40px;

    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;

    flex-direction: column;
    padding: 24px;
}

.npc-name-badge {
    align-self: flex-start;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    padding: 6px 14px;
    margin-bottom: 16px;

    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    letter-spacing: 1px;
}

.dialogue-content-row {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    margin-bottom: 16px;
}

.npc-portrait {
    width: 128px;
    height: 128px;
    margin-right: 16px;
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    background-color: rgb(0, 0, 0);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}

.dialogue-text {
    flex-grow: 1;
    width: 0;
    min-width: 0;
    max-width: 100%;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: normal;
    -unity-text-align: upper-left;
    white-space: normal;
    min-height: 128px;
    padding: 4px 8px;
}

.input-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-width: 0;
    height: 44px;
    margin-top: 8px;
}

.player-input {
    flex-grow: 1;
    min-width: 0;
    margin-right: 8px;
    height: 44px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.player-input > .unity-text-element,
.player-input #unity-text-input {
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-text-align: middle-left;
    padding: 0 12px;
}

.send-button {
    width: 110px;
    height: 44px;
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    color: rgb(0, 0, 0);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
    transition-duration: 0s;
}

.send-button:hover {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

.send-button:active {
    background-color: rgba(255, 255, 255, 0.6);
    color: rgb(0, 0, 0);
}

.send-button:disabled {
    background-color: rgb(0, 0, 0);
    color: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.35);
}

.close-button {
    position: absolute;
    top: 8px;
    right: 8px;

    width: 28px;
    height: 28px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    transition-duration: 0s;
}

.close-button:hover {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

.close-button:active {
    background-color: rgba(255, 255, 255, 0.6);
    color: rgb(0, 0, 0);
}
