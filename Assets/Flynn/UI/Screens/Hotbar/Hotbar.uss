/* ── Flynn draft palette: monochrome, 1px white outlines, square corners ── */

.screen-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 24px;
}

/* ── Hotbar panel ─────────────────────────────────────────────────────────── */

.hotbar-root {
    flex-direction: row;
    align-items: center;
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    padding: 8px;
}

/* ── Individual slot ──────────────────────────────────────────────────────── */

.hotbar-slot {
    width: 64px;
    height: 64px;
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    margin-left: 4px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
}

/* Active slot: 2px border, slightly lighter fill to distinguish */
.hotbar-slot--active {
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(18, 18, 18);
}

/* ── Slot key label (top-left corner) ────────────────────────────────────── */

.slot-key {
    position: absolute;
    top: 3px;
    left: 4px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.45);
    -unity-font-style: normal;
}

/* ── Item icon (centred in slot) ─────────────────────────────────────────── */

.slot-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
}
