/* Dialogue sheet — flat black, 1px white, square. Bottom-anchored, ~62% width. */

.dialogue-panel {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: flex-end;
}

.dialogue-panel.hidden { display: none; }
.hidden { display: none; }

.dialogue-sheet {
    width: 62%;
    min-width: 900px;
    margin-bottom: 18px;
    background-color: rgba(0, 0, 0, 0.92);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    padding: 12px 16px;
}

/* ── Header ─────────────────────────────────────────────────────── */

.dialogue-header {
    flex-direction: row;
    align-items: center;
    border-bottom-color: rgba(255, 255, 255, 0.25);
    border-bottom-width: 1px;
    padding-bottom: 8px;
    margin-bottom: 10px;
}

.nameplate-text {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-right: 18px;
}

.trust-section {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.trust-label {
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.trust-bar-track {
    width: 180px;
    height: 10px;
    background-color: rgb(0, 0, 0);
    border-color: rgba(255, 255, 255, 0.7);
    border-width: 1px;
    padding: 2px;
    position: relative;
    overflow: hidden;
    flex-direction: row;
}

.trust-bar-fill {
    width: 20%;
    height: 100%;
    background-color: rgb(255, 255, 255);
}

.gauge-tick-d {
    position: absolute;
    top: 0; bottom: 0;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.35);
}
.gauge-tick-d--25 { left: 25%; }
.gauge-tick-d--50 { left: 50%; }
.gauge-tick-d--75 { left: 75%; }

.trust-value {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 8px;
    min-width: 28px;
}

.trust-floating-text {
    color: rgb(255, 204, 0);
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 8px;
}

.header-right {
    flex-direction: row;
    align-items: center;
}

.secrets-counter {
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    letter-spacing: 1px;
    margin-right: 10px;
}

.codex-button, .close-button {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    border-color: rgba(255, 255, 255, 0.6);
    border-width: 1px;
    border-radius: 0;
    padding: 3px 10px;
    margin-left: 6px;
    font-size: 13px;
}
.codex-button:hover, .close-button:hover {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

/* ── Body: portrait | conversation | portrait ───────────────────── */

.dialogue-body {
    flex-direction: row;
    align-items: stretch;
}

.portrait-col {
    width: 132px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 2px;
}

.portrait-frame {
    width: 120px;
    height: 120px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    align-items: center;
    justify-content: center;
}

.portrait-image {
    width: 112px;
    height: 112px;
    -unity-background-scale-mode: scale-to-fit;
}

.portrait-cap {
    margin-top: 5px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.dialogue-center {
    flex-grow: 1;
    margin-left: 14px;
    margin-right: 14px;
    flex-direction: column;
}

.conversation-scroll {
    height: 150px;
    margin-bottom: 8px;
}

.dialogue-text {
    color: rgb(255, 255, 255);
    font-size: 17px;
    white-space: normal;
}

/* ── Reply chips ────────────────────────────────────────────────── */

.suggestions-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.suggestion-button {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    border-color: rgba(255, 255, 255, 0.55);
    border-width: 1px;
    border-radius: 0;
    padding: 5px 10px;
    margin-right: 6px;
    font-size: 14px;
}
.suggestion-button:hover {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

/* ── Context strip (TOPICS │ ITEMS) ─────────────────────────────── */

.context-strip {
    flex-direction: row;
    border-top-color: rgba(255, 255, 255, 0.18);
    border-top-width: 1px;
    padding-top: 6px;
    margin-bottom: 8px;
}

.context-group {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-right: 18px;
}

.context-cap {
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.topics-row, .items-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.topic-chip, .topic-chip--locked, .item-chip, .item-chip--gift {
    font-size: 13px;
    padding: 3px 8px;
}

/* ── Input ──────────────────────────────────────────────────────── */

.input-row {
    flex-direction: row;
    align-items: center;
}

.input-caret {
    color: rgba(255, 255, 255, 0.6);
    font-size: 16px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.player-input {
    flex-grow: 1;
    margin-right: 8px;
}

.player-input > .unity-text-field__input {
    background-color: rgb(0, 0, 0);
    border-color: rgba(255, 255, 255, 0.6);
    border-width: 1px;
    border-radius: 0;
    color: rgb(255, 255, 255);
    font-size: 15px;
    padding: 6px 10px;
}

.send-button {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 6px 16px;
    font-size: 15px;
    -unity-font-style: bold;
}
.send-button:hover {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
}
