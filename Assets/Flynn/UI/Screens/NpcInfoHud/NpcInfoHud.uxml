<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="NpcInfoHud.uss" />

    <ui:VisualElement name="hud-root" class="hud-root hidden" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="panel">
            <ui:VisualElement class="header-row">
                <ui:Label name="npc-name" class="text-xl token-text" text="Stranger" />
                <ui:Label name="hotkey-hint" class="hotkey-hint" text="[E] Talk" />
            </ui:VisualElement>

            <ui:Label name="role-tag" class="text-sm token-text-muted role-tag" text="Villager" />

            <ui:VisualElement class="divider" />

            <ui:VisualElement name="relationship-block" class="relationship-block">
                <ui:VisualElement class="bar-row">
                    <ui:Label class="bar-label" text="Trust" />
                    <ui:VisualElement class="bar-track">
                        <ui:VisualElement name="trust-fill" class="bar-fill" />
                    </ui:VisualElement>
                    <ui:Label name="trust-value" class="bar-value text-mono" text="0" />
                </ui:VisualElement>

                <ui:VisualElement class="bar-row">
                    <ui:Label class="bar-label" text="Affection" />
                    <ui:VisualElement class="bar-track">
                        <ui:VisualElement name="affection-fill" class="bar-fill" />
                    </ui:VisualElement>
                    <ui:Label name="affection-value" class="bar-value text-mono" text="0" />
                </ui:VisualElement>

                <ui:VisualElement class="bar-row">
                    <ui:Label class="bar-label" text="Suspicion" />
                    <ui:VisualElement class="bar-track">
                        <ui:VisualElement name="suspicion-fill" class="bar-fill suspicion" />
                    </ui:VisualElement>
                    <ui:Label name="suspicion-value" class="bar-value text-mono" text="0" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="divider" />

            <ui:Label class="section-header" text="Topics" />
            <ui:VisualElement name="known-topics" class="chip-row" />
            <ui:Label name="avoided-header" class="section-header faint hidden" text="Avoids" />
            <ui:VisualElement name="avoided-topics" class="chip-row" />

            <ui:VisualElement class="divider" />

            <ui:Label class="section-header" text="Fetched for last input [debug]" />
            <ui:VisualElement name="fetched-knowledge" class="chip-row" />

            <ui:VisualElement class="divider" />

            <ui:VisualElement class="memory-row">
                <ui:Label name="memory-count" class="text-sm token-text-muted" text="No memories yet." />
            </ui:VisualElement>
            <ui:Label name="last-turn" class="text-xs token-text-faint last-turn" text="" />

            <ui:VisualElement class="divider" />

            <ui:Label class="section-header" text="Last LLM Update [debug]" />
            <ui:VisualElement name="debug-update" class="debug-update">
                <ui:Label name="debug-topic"     class="debug-line text-mono" text="topic: —" />
                <ui:VisualElement class="debug-deltas">
                    <ui:Label name="debug-trust"     class="debug-delta text-mono" text="TRUST 0" />
                    <ui:Label name="debug-affection" class="debug-delta text-mono" text="AFF 0" />
                    <ui:Label name="debug-suspicion" class="debug-delta text-mono" text="SUSP 0" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
