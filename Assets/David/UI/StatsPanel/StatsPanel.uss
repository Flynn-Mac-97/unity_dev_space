/* Stats panel — Flynn wireframe palette: black surfaces, 1px white outlines, square corners. */

.hidden { display: none; }

.stats-overlay {
    position: absolute;
    left: 412px;
    top: 24px;
}

.stats-panel {
    width: 190px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    flex-direction: column;
    padding: 14px;
}

.stats-title {
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 16px;
}

.stat-icon {
    color: rgba(255, 255, 255, 0.47);
    font-size: 7px;
    -unity-text-align: middle-left;
}

.stat-label {
    color: rgba(255, 255, 255, 0.47);
    font-size: 7px;
    -unity-text-align: middle-left;
}

.stat-value {
    color: rgb(255, 255, 255);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.25);
    margin-top: 5px;
    margin-bottom: 5px;
}