<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Flynn/UI/Styles/tokens.uss" />
    <ui:Style src="DialogueBox.uss" />

    <!-- Bottom sheet, ~62% width. Three columns: player portrait | conversation | npc portrait. -->
    <ui:VisualElement name="dialogue-panel" class="dialogue-panel hidden">
        <ui:VisualElement class="dialogue-sheet">

            <!-- Header: name, trust (with threshold ticks), secrets, buttons -->
            <ui:VisualElement class="dialogue-header">
                <ui:Label name="npc-name" class="nameplate-text" text="Stranger" />
                <ui:VisualElement class="trust-section">
                    <ui:Label class="trust-label" text="TRUST" />
                    <ui:VisualElement class="trust-bar-track">
                        <ui:VisualElement name="trust-bar-fill" class="trust-bar-fill" />
                        <ui:VisualElement class="gauge-tick-d gauge-tick-d--25" />
                        <ui:VisualElement class="gauge-tick-d gauge-tick-d--50" />
                        <ui:VisualElement class="gauge-tick-d gauge-tick-d--75" />
                    </ui:VisualElement>
                    <ui:Label name="trust-value" class="trust-value" text="20" />
                    <ui:Label name="trust-floating-text" class="trust-floating-text" style="display: none;" />
                </ui:VisualElement>
                <ui:VisualElement class="header-right">
                    <ui:Label name="secrets-counter" class="secrets-counter" text="0/0" />
                    <ui:Button name="codex-button" class="codex-button" text="&#x25A4;" />
                    <ui:Button name="close-button" class="close-button" text="X" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Body: three columns -->
            <ui:VisualElement class="dialogue-body">

                <ui:VisualElement class="portrait-col">
                    <ui:VisualElement class="portrait-frame">
                        <ui:VisualElement name="player-portrait" class="portrait-image" />
                    </ui:VisualElement>
                    <ui:Label class="portrait-cap" text="YOU" />
                </ui:VisualElement>

                <ui:VisualElement class="dialogue-center">
                    <ui:ScrollView name="conversation-scroll" class="conversation-scroll">
                        <ui:Label name="dialogue-text" class="dialogue-text" text="..." />
                    </ui:ScrollView>

                    <ui:VisualElement name="suggestions-row" class="suggestions-row" style="display: none;" />

                    <!-- Context strip: topics + items share one labeled band -->
                    <ui:VisualElement name="context-strip" class="context-strip">
                        <ui:VisualElement class="context-group">
                            <ui:Label class="context-cap" text="TOPICS" />
                            <ui:VisualElement name="topics-row" class="topics-row" style="display: none;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="context-group">
                            <ui:Label class="context-cap" text="ITEMS" />
                            <ui:VisualElement name="items-row" class="items-row" style="display: none;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="input-row">
                        <ui:Label class="input-caret" text="&gt;" />
                        <ui:TextField name="player-input" class="player-input" />
                        <ui:Button name="send-button" class="send-button" text="&#x25B6;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="portrait-col">
                    <ui:VisualElement class="portrait-frame">
                        <ui:VisualElement name="npc-portrait" class="portrait-image hidden" />
                    </ui:VisualElement>
                    <ui:Label name="npc-portrait-cap" class="portrait-cap" text="THEM" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
