  m_Script: {fileID: 11500000, guid: 2ad88bbb0ce7b86478477c5086507618, type: 3}
  m_Name: Maren_WindKeeper_Knowledge
  m_EditorClassIdentifier: 
  knownFacts:
  - topic: {fileID: 11400000, guid: 8e73c156320583c48a35d9baa9267ff4, type: 2}
    text: There is a steady current between the two big islands. A small boat is
      fastest at dawn.
    oneTime: 0
    reveal: 0
    threshold: 0
    flagKey: 
  - topic: {fileID: 11400000, guid: 9d74f7aa73eac464993f55e6d2eaf9a7, type: 2}
    text: Jorin lives south. He fixes anything that turns or blows.
    oneTime: 0
    reveal: 0
    threshold: 0
    flagKey: 
  beliefs:
  - topic: {fileID: 11400000, guid: b1c4466993707c34aaf3f4db120ab6ff, type: 2}
    text: The sky split the year I was born. Half the village still says so. I think
      it was only a bad storm.
    oneTime: 0
    reveal: 0
    threshold: 0
    flagKey: 
  rumors:
  - topic: {fileID: 11400000, guid: 1e64cfd57762657459a1121080db3287, type: 2}
    text: Travelers whisper that the north cave is sealed by a song. Or by a tool.
      I forget which.
    oneTime: 0
    reveal: 1
    threshold: 40
    flagKey: 
  secrets:
  - topic: {fileID: 11400000, guid: 1e64cfd57762657459a1121080db3287, type: 2}
    text: The cave opens for whoever stands at the mouth when the sky tunnel blows
      north. Jorin's pumps can hold the door for one breath.
    oneTime: 0
    reveal: 1
    threshold: 75
    flagKey: 
  avoidedTopics:
  - {fileID: 11400000, guid: b1c4466993707c34aaf3f4db120ab6ff, type: 2}
