/* Quest menu — Flynn wireframe palette: black surfaces, 1px white outlines, square corners. */

.hidden { display: none; }

.quest-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.quest-panel {
    width: 420px;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    flex-direction: column;
    padding: 28px;
}

.quest-title {
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.section-header {
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.quest-item {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.quest-status {
    width: 10px;
    height: 10px;
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    margin-top: 4px;
    margin-right: 10px;
    flex-shrink: 0;
}

.quest-status--active {
    background-color: rgb(255, 255, 255);
}

.quest-status--completed {
    background-color: rgb(0, 0, 0);
}

.quest-status--locked {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
}

.quest-text {
    flex-direction: column;
    flex-grow: 1;
}

.quest-name {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.quest-name--locked {
    color: rgba(255, 255, 255, 0.3);
}

.quest-desc {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.25);
    margin-top: 10px;
    margin-bottom: 10px;
}
