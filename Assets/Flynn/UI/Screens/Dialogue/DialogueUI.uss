/* === Dialogue screen — Flynn draft tokens (monochrome wireframe) ===
   Black surfaces, 1px white outlines, square corners, white-on-black.
   See Assets/Flynn/CLAUDE.md "Flynn UI draft palette". */

/* CRITICAL: DialogueManager toggles this class to show/hide the panel and
   the portrait. Without it the panel never hides. Do not rename. */
.hidden {
    display: none;
}

/* Full-screen transparent overlay; anchors the panel to the bottom. */
.dialogue-root {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 32px;
}

/* The dialogue panel itself — bottom-center, fixed comfortable width. */
.dialogue-panel {
    width: 720px;
    max-width: 90%;
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    padding: 16px;
}

/* NPC name — small badge above the body copy. */
.npc-name-badge {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 8px;
}

/* Portrait + text sit side by side. */
.dialogue-content-row {
    flex-direction: row;
    align-items: flex-start;
}

.npc-portrait {
    width: 96px;
    height: 96px;
    margin-right: 16px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.dialogue-text {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(255, 255, 255);
    white-space: normal;
}

/* Suggested-reply buttons stack vertically; hidden until populated. */
.suggestions-row {
    flex-direction: column;
    margin-top: 8px;
}

.suggestion-button {
    background-color: rgb(0, 0, 0);
    color: rgba(255, 255, 255, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 0;
    padding: 8px 16px;
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.suggestion-button:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
}

/* Player input + send button on one row. */
.input-row {
    flex-direction: row;
    margin-top: 16px;
}

.player-input {
    flex-grow: 1;
    margin-right: 8px;
}

.player-input > .unity-text-field__input {
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    color: rgb(255, 255, 255);
    padding: 8px;
}

/* Shared button look — black with 1px white outline, inverts on hover. */
.send-button,
.close-button {
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    padding: 8px 16px;
    font-size: 14px;
}

.send-button:hover,
.close-button:hover {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

.send-button:active,
.close-button:active {
    background-color: rgba(255, 255, 255, 0.6);
    color: rgb(0, 0, 0);
}

/* Close button pinned to the panel's top-right corner. */
.close-button {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 10px;
}
