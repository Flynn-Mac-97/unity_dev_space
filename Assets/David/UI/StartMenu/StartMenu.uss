/* Start menu — Flynn wireframe palette adapted for full-screen start screen. */

.start-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
}

.start-title {
    margin-top: 50px;
    color: rgb(255, 255, 255);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    white-space: nowrap;
}

.button-container {
    margin-top: auto;
    margin-bottom: 50px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.menu-button {
    width: 220px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.7);
    color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    border-radius: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 12px;
    transition-duration: 0s;
}

.menu-button:hover {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

.menu-button:active {
    background-color: rgba(255, 255, 255, 0.6);
    color: rgb(0, 0, 0);
}
