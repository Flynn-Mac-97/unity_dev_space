/* ResourceHP — MVP blockout. Flat black, 1px white, square. */

.resource-hp-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}
.health-bar {
    position: absolute;
    width: 80px;
    height: 6px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0s;
}
.health-bar--visible { opacity: 1; }
.health-bar--fading {
    opacity: 0;
    transition-duration: 0.5s;
}
.health-bar__bg {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    border-color: rgb(255, 255, 255);
    border-width: 1px;
    padding: 1px;
    overflow: hidden;
}
.health-bar__fill {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
}
