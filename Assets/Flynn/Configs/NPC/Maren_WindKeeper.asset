  m_Name: Maren_WindKeeper_Triggers
  m_EditorClassIdentifier: 
  triggers:
  - key: trigger.maren.first_meeting
    topic: {fileID: 0}
    kind: 2
    text: First time the player meets Maren she comments on the wind direction and
      asks where they came from.
    draft: 0
  - key: trigger.maren.clue_cave_north
    topic: {fileID: 11400000, guid: 1e64cfd57762657459a1121080db3287, type: 2}
    kind: 1
    text: Maren mentions a sealed cave to the north when the player brings up old
      places or asks about secrets.
    draft: 0
  - key: trigger.maren.secret_cave_method
    topic: {fileID: 11400000, guid: 1e64cfd57762657459a1121080db3287, type: 2}
    kind: 5
    text: If trust is high enough, Maren tells the player how the cave actually opens
      (sky tunnel + a wind pump).
    draft: 0
  - key: trigger.maren.forbid_storm_year
    topic: {fileID: 11400000, guid: b1c4466993707c34aaf3f4db120ab6ff, type: 2}
    kind: 4
    text: Maren refuses to discuss the Storm Year directly. She changes the subject
      to birds or weather.
    draft: 0
